<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Antibiotic Selection Assistant | NAG 2024</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-blue-900 text-white p-4 shadow-md">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold flex items-center gap-2">
                    <i class="fas fa-pills"></i> CDSS Antimicrobial Assistant
                </h1>
                <p class="text-blue-200 text-sm mt-1">Based on Malaysia MOH National Antimicrobial Guideline (NAG) 2024, 4th Ed.</p>
            </div>
            <div class="hidden md:flex gap-4">
                <a href="https://sites.google.com/moh.gov.my/nag" target="_blank" class="text-sm bg-blue-800 hover:bg-blue-700 px-3 py-2 rounded transition">
                    <i class="fas fa-external-link-alt"></i> Official NAG Site
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-6xl mx-auto p-4 grid grid-cols-1 lg:grid-cols-3 gap-6 w-full mt-4">
        
        <!-- Left Column: Patient Assessment -->
        <div class="lg:col-span-1 bg-white p-5 rounded-lg shadow-sm border border-slate-200">
            <h2 class="text-lg font-bold border-b pb-2 mb-4 text-slate-700">Patient Assessment</h2>
            
            <form id="assessmentForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold mb-1">Infection Site / Syndrome</label>
                    <select id="infectionSite" class="w-full border rounded p-2 text-sm bg-slate-50">
                        <option value="uti_uncomplicated">Uncomplicated UTI</option>
                        <option value="urosepsis_no_shock">Urosepsis (Without Shock)</option>
                        <option value="urosepsis_shock">Urosepsis (With Shock)</option>
                        <option value="cap_mild">Community Acquired Pneumonia (Mild)</option>
                        <option value="ssti">Skin & Soft Tissue Infection (SSTI)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Clinical Signs & Symptoms</label>
                    <textarea id="symptoms" rows="3" class="w-full border rounded p-2 text-sm bg-slate-50" placeholder="E.g., fever 39C, dysuria, altered mental status..."></textarea>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-sm font-semibold mb-1">eGFR (mL/min)</label>
                        <input type="number" id="egfr" class="w-full border rounded p-2 text-sm bg-slate-50" placeholder=">90" value="95">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-1">Weight (kg)</label>
                        <input type="number" class="w-full border rounded p-2 text-sm bg-slate-50" placeholder="70" value="70">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Allergies</label>
                    <select id="allergies" class="w-full border rounded p-2 text-sm bg-slate-50">
                        <option value="none">No Known Allergies</option>
                        <option value="penicillin_mild">Penicillin (Mild/Non-IgE)</option>
                        <option value="penicillin_severe">Penicillin (Severe/Anaphylaxis)</option>
                        <option value="sulfa">Sulfa Drugs</option>
                    </select>
                </div>

                <div class="pt-2">
                    <button type="button" onclick="generateRecommendation()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition flex justify-center items-center gap-2">
                        <i class="fas fa-magic"></i> Generate NAG 2024 Recommendation
                    </button>
                </div>
            </form>
        </div>

        <!-- Right Column: Results & Guidelines -->
        <div class="lg:col-span-2 space-y-6">
            
            <!-- Output Panel -->
            <div class="bg-white p-5 rounded-lg shadow-sm border border-slate-200 min-h-[250px]">
                <div class="flex justify-between items-center border-b pb-2 mb-4">
                    <h2 class="text-lg font-bold text-slate-700">Clinical Recommendation</h2>
                    <span id="statusBadge" class="bg-slate-100 text-slate-500 text-xs font-bold px-2 py-1 rounded">Awaiting Input</span>
                </div>
                
                <div id="recommendationOutput" class="text-slate-600 text-sm space-y-4">
                    <div class="text-center py-10">
                        <i class="fas fa-stethoscope text-4xl text-slate-300 mb-3"></i>
                        <p>Enter patient parameters and generate to view recommendations aligned with the NAG 2024 guidelines.</p>
                    </div>
                </div>
            </div>

            <!-- AMS & Guideline Snippets -->
            <div class="bg-yellow-50 p-5 rounded-lg shadow-sm border border-yellow-200">
                <h3 class="text-md font-bold text-yellow-800 mb-2 flex items-center gap-2">
                    <i class="fas fa-exclamation-triangle"></i> AMS Principles (NAG 2024)
                </h3>
                <ul class="text-sm text-yellow-900 space-y-2 list-disc pl-5">
                    <li><strong>UTI Empiric Therapy:</strong> Trimethoprim-sulfamethoxazole is NOT recommended as empirical therapy for UTI (local E. coli / K. pneumoniae resistance >30%).</li>
                    <li><strong>IV to Oral Switch Criteria:</strong> Consider switching at 48-72 hours if patient is afebrile >48h, clinically improving, able to tolerate oral intake, and has normal GI absorption.</li>
                    <li><strong>Optimization:</strong> Streamline broad-spectrum antibiotics to narrower spectrum based on culture results at 48-72 hours.</li>
                </ul>
            </div>

        </div>
    </main>

    <script>
        // Mock offline database reflecting actual MOH Malaysia NAG 2024 Guidelines
        const nagDatabase = {
            "uti_uncomplicated": {
                condition: "Uncomplicated Urinary Tract Infection",
                preferred: [
                    "Nitrofurantoin 50-100mg PO q6h (immediate-release) OR 100mg PO q12h (sustained-release) for 3-5 days.",
                    "Amoxicillin/clavulanate 625mg PO q8h for 3-5 days."
                ],
                alternative: [
                    "Cephalexin 500mg PO q12h for 3-5 days.",
                    "Fosfomycin 3g PO x 1 dose (If confirmed ESBL E.coli sensitive to fosfomycin, every 48hrs for 3 doses)."
                ],
                warnings: [
                    "Avoid Nitrofurantoin if eGFR < 30 ml/min.",
                    "Avoid Trimethoprim-sulfamethoxazole empirically due to high local resistance.",
                    "Avoid Ampicillin/Amoxicillin empirically due to high resistance."
                ]
            },
            "urosepsis_no_shock": {
                condition: "Urosepsis (Without Shock)",
                preferred: [
                    "Ceftriaxone 2g IV q24h for ≥ 7 days.",
                    "Cefotaxime 2g IV q8h for ≥ 7 days."
                ],
                alternative: [
                    "Ceftazidime 2g IV q8h for ≥ 7 days.",
                    "Cefepime 2g IV q8h for ≥ 7 days."
                ],
                warnings: ["Consider adding Aminoglycoside if patient is at risk of Pseudomonas aeruginosa."]
            },
            "urosepsis_shock": {
                condition: "Urosepsis (With Shock)",
                preferred: [
                    "Piperacillin-tazobactam 4.5g IV q6-8h (If q8h, use extended infusion over 3-4 hours) for ≥ 7 days."
                ],
                alternative: [
                    "Meropenem 1g IV q8h (Reserve for risk factors for MDR/ESBL).",
                    "Imipenem 500mg IV q6h (Reserve for risk factors for MDR/ESBL)."
                ],
                warnings: ["Aggressive fluid resuscitation required alongside early antimicrobial administration."]
            }
        };

        function generateRecommendation() {
            const site = document.getElementById('infectionSite').value;
            const egfr = parseInt(document.getElementById('egfr').value);
            const allergy = document.getElementById('allergies').value;
            const output = document.getElementById('recommendationOutput');
            const badge = document.getElementById('statusBadge');

            output.innerHTML = `<div class="text-center py-10"><i class="fas fa-spinner fa-spin text-3xl text-blue-500"></i><p class="mt-2 text-slate-500">Consulting NAG 2024 database...</p></div>`;
            
            setTimeout(() => {
                const data = nagDatabase[site];
                
                if(!data) {
                    output.innerHTML = `<p class="text-red-500">Guideline data not fully mapped for this selection in the demo.</p>`;
                    return;
                }

                // Logic checks based on NAG
                let safetyAlerts = "";
                let selectedRegimen = "";
                
                // eGFR rule for Nitrofurantoin
                let excludeNitro = false;
                if (site === 'uti_uncomplicated' && egfr < 30) {
                    excludeNitro = true;
                    safetyAlerts += `<div class="bg-red-100 text-red-800 p-2 rounded mb-2 text-xs font-bold"><i class="fas fa-ban"></i> CONTRAINDICATION: Nitrofurantoin avoided due to eGFR < 30 ml/min.</div>`;
                }

                // Penicillin allergy rule
                let isPenAllergic = (allergy === 'penicillin_severe' || allergy === 'penicillin_mild');
                if (isPenAllergic) {
                    safetyAlerts += `<div class="bg-orange-100 text-orange-800 p-2 rounded mb-2 text-xs font-bold"><i class="fas fa-exclamation-circle"></i> ALLERGY WARNING: Penicillin allergy noted. Evaluating cross-reactivity.</div>`;
                }

                // Build HTML
                let html = `
                    <h3 class="font-bold text-lg text-slate-800 border-b pb-1">${data.condition}</h3>
                    <div class="mt-3">
                        ${safetyAlerts}
                    </div>
                    
                    <div class="mt-4">
                        <h4 class="font-bold text-green-700 text-sm uppercase tracking-wide">Preferred Agents</h4>
                        <ul class="list-disc pl-5 mt-1 text-sm space-y-1">
                            ${data.preferred.map(item => {
                                if (excludeNitro && item.includes('Nitrofurantoin')) {
                                    return `<li><del class="text-slate-400">${item}</del> <span class="text-red-500 text-xs ml-1">(Contraindicated by eGFR)</span></li>`;
                                }
                                if (isPenAllergic && (item.includes('Amoxicillin') || item.includes('Piperacillin'))) {
                                    return `<li><del class="text-slate-400">${item}</del> <span class="text-orange-500 text-xs ml-1">(Avoid due to Penicillin Allergy)</span></li>`;
                                }
                                return `<li><strong>${item.split(' ')[0]}</strong> ${item.substring(item.indexOf(' '))}</li>`;
                            }).join('')}
                        </ul>
                    </div>

                    <div class="mt-4">
                        <h4 class="font-bold text-blue-700 text-sm uppercase tracking-wide">Alternative Agents</h4>
                        <ul class="list-disc pl-5 mt-1 text-sm space-y-1">
                             ${data.alternative.map(item => `<li><strong>${item.split(' ')[0]}</strong> ${item.substring(item.indexOf(' '))}</li>`).join('')}
                        </ul>
                    </div>

                    <div class="mt-4 bg-slate-100 p-3 rounded border border-slate-200">
                        <h4 class="font-bold text-slate-700 text-xs uppercase tracking-wide mb-1">NAG 2024 Clinical Comments</h4>
                        <ul class="list-disc pl-4 text-xs space-y-1 text-slate-600">
                            ${data.warnings.map(w => `<li>${w}</li>`).join('')}
                        </ul>
                    </div>
                `;

                output.innerHTML = html;
                badge.className = "bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded";
                badge.innerText = "Guideline Applied";

            }, 800);
        }
    </script>
</body>
</html>
